# PayPal REST app (Sandbox) - developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Any OpenAI-compatible chat endpoint
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Protects the dashboard API (sent as the X-Admin-Key header)
ADMIN_KEY=change-me

# Public URL of this server, used in approval links (e.g. https://settle.onrender.com)
BASE_URL=http://localhost:8010

# Sandbox only: send every invoice to this Personal sandbox buyer so test payments work
CLIENT_EMAIL=

# Optional
# DB_PATH=invoice_agent.db
# PORT=8010
